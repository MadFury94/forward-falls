# ─────────────────────────────────────────────────────────────
# .env.example — copy this to .env.local and fill in your values
# Never commit .env.local to version control
# ─────────────────────────────────────────────────────────────

# ── WordPress / Headless CMS ──────────────────────────────────
# Full URL to your WordPress install (no trailing slash)
WORDPRESS_SITE_URL=https://your-wordpress-site.com

# WordPress REST API base (usually WORDPRESS_SITE_URL + /wp-json/wp/v2)
WORDPRESS_API_URL=https://your-wordpress-site.com/wp-json/wp/v2

# Application Password — generate in WP Admin > Users > Your Profile > Application Passwords
WORDPRESS_AUTH_USERNAME=your_wp_admin_username
WORDPRESS_AUTH_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Email address associated with the WP admin account
WORDPRESS_AUTH_EMAIL=admin@your-org.com

# ── JWT Auth (WP plugin: JWT Authentication for WP-API) ───────
# Must match the secret set in wp-config.php:
#   define('JWT_AUTH_SECRET_KEY', 'your-secret-here');
JWT_SECRET_KEY=replace-with-a-long-random-string

# ── Headless Admin Panel ──────────────────────────────────────
# Credentials for the custom /admin-login panel (NOT WordPress login)
NEXT_PUBLIC_ADMIN_USERNAME=super_admin
NEXT_PUBLIC_ADMIN_EMAIL=admin@your-org.com
ADMIN_PASSWORD=replace-with-a-strong-password

# ── Public Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-public-site.com

# ── On-demand Revalidation ────────────────────────────────────
# Shared secret between WordPress (webhook) and Next.js /api/revalidate
REVALIDATE_SECRET=replace-with-random-string
NEXT_PUBLIC_REVALIDATE_SECRET=replace-with-random-string

# ── Email (Resend) ────────────────────────────────────────────
# Get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
